{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/finalize-request-v1.json",
  "title": "OwlCoda RunKit Finalize Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "deliveryPacketPath", "verificationContext", "snapshotPaths"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitFinalizeRequestV1" },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "deliveryPacketPath": { "type": "string", "minLength": 1 },
    "verificationContext": { "$ref": "verification-context-v1.schema.json" },
    "snapshotPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
