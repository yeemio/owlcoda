{
  "name": "owlcoda",
  "version": "0.15.30",
  "description": "OwlCoda — independent local-first AI coding platform with a native REPL, 42+ tools, and local model routing.",
  "license": "GPL-3.0-or-later",
  "author": "yeemio <yeemio@gmail.com>",
  "homepage": "https://github.com/yeemio/owlcoda#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeemio/owlcoda.git"
  },
  "bugs": {
    "url": "https://github.com/yeemio/owlcoda/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "coding",
    "local-first",
    "ollama",
    "lm-studio",
    "vllm",
    "tui",
    "repl",
    "openai-compatible",
    "workbench"
  ],
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/public-mirror/",
    "skills/",
    "schemas/",
    "assets/branding/",
    "config.example.json",
    "scripts/postbuild.mjs",
    "scripts/runkit-contract/",
    "!scripts/runkit-contract/install-codex-skill.mjs",
    "!scripts/runkit-contract/templates/verification-context.json",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "docs/INSTRUCTION_CHAIN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SOURCE.md",
    "NOTICE.md"
  ],
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "default": "./dist/desktop.js"
    },
    "./headless": "./dist/headless.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "owlcoda": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && npm --prefix admin ci && npm --prefix admin run build && node scripts/postbuild.mjs",
    "dev": "node --import tsx src/cli.ts",
    "desktop:dev": "node scripts/start-owlcoda-desktop-preview.mjs",
    "desktop:osui:test": "node --test desktop/osui/tests/*.test.mjs",
    "desktop:osui:typecheck": "npm --prefix desktop/osui run typecheck",
    "desktop:osui:build": "npm --prefix desktop/osui run build",
    "desktop:osui:vendor-audit": "node desktop/osui/scripts/vendor-provenance-audit.mjs",
    "app-server:contract:generate": "npx tsx scripts/generate-app-server-contract.ts",
    "app-server:contract:check": "npx tsx scripts/generate-app-server-contract.ts --check",
    "smoke": "bash scripts/smoke-test.sh",
    "release:smoke": "npx tsx scripts/release-smoke.ts",
    "test": "vitest run",
    "test:serial": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "verify": "npx tsx tests/sdk-verify.ts",
    "smoke:fast": "OWLCODA_SMOKE_FAST=1 bash scripts/smoke-test.sh",
    "blackbox": "bash scripts/smoke-longtask-blackbox.sh",
    "blackbox:build": "OWLCODA_QA_BUILD=1 bash scripts/smoke-longtask-blackbox.sh",
    "prepublishOnly": "npm run release:smoke"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.2.5",
    "auto-bind": "^5.0.1",
    "bidi-js": "^1.0.3",
    "chalk": "^5.6.2",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "emoji-regex": "^10.6.0",
    "get-east-asian-width": "^1.5.0",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.18.1",
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0",
    "semver": "^7.7.4",
    "signal-exit": "^4.1.0",
    "slice-ansi": "^8.0.0",
    "stack-utils": "^2.0.6",
    "string-width": "^8.2.0",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "type-fest": "^5.6.0",
    "usehooks-ts": "^3.1.1",
    "wrap-ansi": "^10.0.0"
  }
}
