{
  "name": "owlcoda-demo-worldcup-predictor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OwlCoda official demo: 2026 World Cup match prediction workbench powered by your own models via the OwlCoda proxy.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "demo": "concurrently -n server,web -c blue,magenta \"npm run server\" \"npm run web\"",
    "server": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
